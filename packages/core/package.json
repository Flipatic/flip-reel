{
  "name": "@flipatic/flip-reel-core",
  "version": "0.2.1",
  "description": "Headless engine for the FlipReel widget",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flipatic/flip-reel.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Flipatic/flip-reel#readme",
  "bugs": "https://github.com/Flipatic/flip-reel/issues",
  "author": "Flipatic (https://flipatic.com)",
  "contributors": [
    "Autentika (https://autentika.com)"
  ],
  "keywords": [
    "reels",
    "stories",
    "web-component",
    "lit",
    "embeddable",
    "ads",
    "publisher",
    "headless",
    "video",
    "shorts",
    "news",
    "state-machine"
  ],
  "publishConfig": {
    "access": "public"
  }
}
