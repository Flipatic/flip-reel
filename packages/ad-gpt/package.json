  "contributors": [
    "Autentika (https://autentika.com)"
  ],
  "keywords": [
    "reels",
    "stories",
    "web-component",
    "lit",
    "embeddable",
    "ads",
    "publisher",
    "google-ad-manager",
    "gpt",
    "advertising",
    "video",
    "news"
  ],
  "publishConfig": {
