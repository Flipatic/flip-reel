{
  "name": "flip-reel",
  "version": "0.2.1",
  "private": true,
  "description": "Open-source embeddable stories/reels widget for publishers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flipatic/flip-reel.git"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
